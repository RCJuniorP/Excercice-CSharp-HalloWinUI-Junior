<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HalloWinUI.Views.AjoutEnfantPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:HalloWinUI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition>auto</RowDefinition>
            <RowDefinition>auto</RowDefinition>
            <RowDefinition>auto</RowDefinition>
            <RowDefinition>auto</RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition>auto</ColumnDefinition>
        </Grid.ColumnDefinitions>
        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            AutomationProperties.HeadingLevel="Level1"
            FontSize="28"
            FontWeight="SemiBold"
            Text="Maisons d'Halloween" />
        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            AutomationProperties.HeadingLevel="Level2"
            FontSize="20"
            FontWeight="SemiBold"
            Text="{x:Bind ViewModel.SousTitrePage, Mode=OneWay}" />
        <TextBox
            Grid.Row="2"
            Grid.Column="0"
            Header="Nom de l'enfant"
            PlaceholderText="Ex: Alexandre"
            Text="{x:Bind ViewModel.NomEnfant, Mode=TwoWay}" />
        <StackPanel
            Grid.Row="3"
            Grid.Column="0"
            Orientation="Horizontal">
            <Button Click="btnConfirmerEnfant_Click">
                <Button.Content>
                    Confirmer
                </Button.Content>
            </Button>
            <Button Click="btnAnnulerAjout_Click">
                <Button.Content>
                    Annuler
                </Button.Content>
            </Button>
        </StackPanel>
    </Grid>
</Page>
