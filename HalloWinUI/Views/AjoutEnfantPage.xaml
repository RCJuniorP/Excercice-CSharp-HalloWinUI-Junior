<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HalloWinUI.Views.AjoutEnfantPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:DataAnnotations="using:System.ComponentModel.DataAnnotations"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:HalloWinUI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition>auto</RowDefinition>
            <RowDefinition>auto</RowDefinition>
            <RowDefinition>auto</RowDefinition>
            <RowDefinition>auto</RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition>auto</ColumnDefinition>
        </Grid.ColumnDefinitions>
        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            AutomationProperties.HeadingLevel="Level1"
            FontSize="28"
            FontWeight="SemiBold"
            Text="Maisons d'Halloween" />
        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            AutomationProperties.HeadingLevel="Level2"
            FontSize="20"
            FontWeight="SemiBold"
            Text="{x:Bind ViewModel.SousTitrePage, Mode=OneWay}" />
        <StackPanel Grid.Row="2" Grid.Column="0">
            <TextBox
                Header="Nom de l'enfant *"
                PlaceholderText="Ex: Alexandre"
                Text="{x:Bind ViewModel.NouvelEnfant.Nom, Mode=TwoWay}" />
            <ItemsView
                Width="Auto"
                Height="Auto"
                ItemsSource="{x:Bind ViewModel.NouvelEnfant.GetErrors('Nom'), Mode=OneWay}">
                <ItemsView.ItemTemplate>
                    <DataTemplate x:DataType="DataAnnotations:ValidationResult">
                        <ItemContainer
                            Width="Auto"
                            Height="Auto"
                            MaxWidth="100"
                            HorizontalAlignment="Left">
                            <TextBlock Text="{x:Bind ToString(), Mode=OneWay}" TextWrapping="Wrap" />
                        </ItemContainer>
                    </DataTemplate>
                </ItemsView.ItemTemplate>
            </ItemsView>
        </StackPanel>
        <StackPanel
            Grid.Row="3"
            Grid.Column="0"
            Orientation="Horizontal">
            <Button Click="btnConfirmerEnfant_Click">
                <Button.Content>
                    Confirmer
                </Button.Content>
            </Button>
            <Button Click="btnAnnulerAjout_Click">
                <Button.Content>
                    Annuler
                </Button.Content>
            </Button>
        </StackPanel>
    </Grid>
</Page>
