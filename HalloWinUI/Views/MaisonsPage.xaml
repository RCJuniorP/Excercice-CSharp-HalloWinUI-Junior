<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HalloWinUI.Views.MaisonsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:HalloWinUI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:HalloWinUI.ViewModels.Pages"
    mc:Ignorable="d">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Titre de la page  -->
        <TextBlock
            AutomationProperties.HeadingLevel="Level1"
            FontSize="28"
            FontWeight="SemiBold"
            Text="Maisons d'Halloween" />

        <!--  Formulaire d'ajout d'une maison  -->
        <StackPanel
            Grid.Row="1"
            MaxWidth="520"
            HorizontalAlignment="Left"
            Spacing="12">
            <TextBlock
                AutomationProperties.HeadingLevel="Level2"
                FontSize="20"
                FontWeight="SemiBold"
                Text="Ajouter une maison" />

            <Grid ColumnSpacing="8" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Ligne 1 : numéro + rue  -->
                <TextBox
                    Header="Numéro"
                    PlaceholderText="123"
                    Text="" />
                <TextBox
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Header="Rue"
                    PlaceholderText="Rue des Fantômes"
                    Text="" />

                <!--  Ligne 2 : ville + code postal  -->
                <TextBox
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Header="Ville"
                    PlaceholderText="Gatineau"
                    Text="" />
                <TextBox
                    Grid.Row="1"
                    Grid.Column="2"
                    Header="Code postal"
                    MaxLength="7"
                    PlaceholderText="J8X 1A1"
                    Text="" />

                <!--  Ligne 3 : bouton  -->
                <Button Grid.Row="2" Grid.ColumnSpan="3">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock Text="Ajouter" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <!--  Liste des maisons  -->
        <TextBlock
            Grid.Row="2"
            AutomationProperties.HeadingLevel="Level2"
            FontSize="20"
            FontWeight="SemiBold"
            Text="Liste des maisons" />

        <GridView
            Grid.Row="3"
            AutomationProperties.Name="Liste des maisons"
            ItemsSource="{x:Bind ViewModel.Maisons, Mode=OneWay}"
            SelectionMode="Single">

            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="0,0,12,12" />
                </Style>
            </GridView.ItemContainerStyle>

            <GridView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:MaisonViewModel">
                    <!-- Wrong datatype -->
                    <!-- Do bindings -->
                    <Border
                        Width="280"
                        Padding="16"
                        Background="GhostWhite"
                        BorderBrush="#FFFFCC99"
                        BorderThickness="2">
                        <StackPanel Spacing="12">
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="{x:Bind NumeroCivique, Mode=OneWay}" 
                                TextWrapping="Wrap" />
                            <TextBlock
                                FontSize="14"
                                Foreground="Black"
                                Text="" />
                            <CheckBox Content="Signaler" IsChecked="True" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <Button Grid.Row="4" Background="DarkOrange">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                <TextBlock Text="Supprimer" />
            </StackPanel>
        </Button>
    </Grid>
</Page>
