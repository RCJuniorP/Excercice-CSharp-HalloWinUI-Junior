<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HalloWinUI.Views.EnfantsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:HalloWinUI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:HalloWinUI.ViewModels"
    xmlns:viewmodels.Models="using:HalloWinUI.ViewModels.Models"
    xmlns:viewmodels.Pages="using:HalloWinUI.ViewModels.Pages"
    mc:Ignorable="d">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition>auto</RowDefinition>
            <RowDefinition>auto</RowDefinition>
            <RowDefinition>auto</RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition>auto</ColumnDefinition>
        </Grid.ColumnDefinitions>
        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            AutomationProperties.HeadingLevel="Level1"
            FontSize="28"
            FontWeight="SemiBold"
            Text="Maisons d'Halloween" />
        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            AutomationProperties.HeadingLevel="Level2"
            FontSize="20"
            FontWeight="SemiBold"
            Text="Liste des enfants" />
        <GridView
            Grid.Row="2"
            Grid.Column="0"
            AutomationProperties.Name="Liste des enfants"
            ItemsSource="{x:Bind ViewModel.Enfants, Mode=OneWay}"
            SelectionMode="Single">

            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="0,0,12,12" />
                </Style>
            </GridView.ItemContainerStyle>

            <GridView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels.Models:EnfantViewModel">
                    <Border
                        Width="280"
                        Padding="16"
                        Background="GhostWhite"
                        BorderBrush="#FFFFCC99"
                        BorderThickness="2">
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition>auto</ColumnDefinition>
                                <ColumnDefinition>*</ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition>auto</RowDefinition>
                                <RowDefinition>auto</RowDefinition>
                            </Grid.RowDefinitions>
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="Id : " />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Text="{x:Bind Id}" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Text="Nom : " />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="{x:Bind Nom}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
